# Copy to .env and fill in. Never commit your real .env or any credential file.

# TCP port the relay listens on.
RELAY_PORT=8090

# SQLite key store path (hashed keys + device-token bindings).
RELAY_DB_PATH=/data/relay.db

# Guards the /admin endpoints (list + revoke keys). Leave blank to disable admin entirely.
# Generate with: openssl rand -base64 32
RELAY_ADMIN_TOKEN=

# --- FCM (Android) ---
# Path to the Firebase service-account JSON. Leave it commented out to disable Android
# sends; they fail clearly instead of the relay refusing to start. A path that is set but
# unreadable is a startup error.
# RELAY_FCM_CREDENTIALS_FILE=/run/secrets/fcm-service-account.json

# --- APNs (iOS), token-based (.p8) auth ---
# All four of these are required together. Leave them commented out to disable iOS sends;
# they fail clearly instead of the relay refusing to start.
# RELAY_APNS_KEY_PATH=/run/secrets/apns-auth-key.p8
# RELAY_APNS_KEY_ID=
# RELAY_APNS_TEAM_ID=
# RELAY_APNS_BUNDLE_ID=
# true talks to APNs' production gateway; false talks to the sandbox gateway that
# debug/development builds register against.
RELAY_APNS_PRODUCTION=true

# Set to true only when the relay sits behind a reverse proxy that itself sets
# X-Forwarded-For (Caddy, Traefik, nginx proxy_add_x_forwarded_for). When true, the relay
# trusts the RIGHTMOST entry of that header as the real client IP for rate limiting - the one
# hop the trusted proxy itself appended, and the only one an external caller cannot forge.
# WARNING: enabling this with no real proxy in front (or one that does not set the header)
# lets any caller spoof X-Forwarded-For and pick its own rate-limit identity, defeating both
# the per-IP registration limit and this bucket's memory bound. Leave false (the default) and
# the relay always uses the raw socket address instead.
RELAY_TRUST_PROXY=false

# Optional tuning (defaults shown):
# RELAY_REGISTER_PER_HOUR=5        # per-IP registration rate
# RELAY_REGISTER_BURST=3
# RELAY_MAX_REGISTRATIONS=10000    # total keys ever minted; 0 or negative disables the ceiling
# RELAY_SEND_PER_MINUTE=120        # per-key send rate
# RELAY_SEND_BURST=60
# RELAY_CALL_SEND_PER_MINUTE=10    # tighter per-key rate for "call" kind pushes specifically
# RELAY_CALL_SEND_BURST=5
# RELAY_MAX_MESSAGES=500           # device tokens per /v1/send request
# RELAY_SEND_CONCURRENCY=8         # provider sends in flight at once per /v1/send request
# RELAY_SEND_TIMEOUT_SECONDS=20    # hard deadline for one /v1/send request's provider dispatch;
#                                   # 0 or negative disables the deadline entirely
# RELAY_TOKEN_RETENTION_DAYS=90    # prune a device-token binding once its owning key has gone
#                                   # this long without sending to it; 0 or negative disables pruning
# RELAY_MAX_TOKENS_PER_KEY=20000   # most device tokens one key may have bound; 0 or negative disables

# Rate limiting lives in the relay's own memory, not a shared store: it is per-instance and
# in-process, so running more than one replica multiplies the effective limits above rather
# than sharing one budget across them.
